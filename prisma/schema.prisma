generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PropertyPurpose {
  VENDA
  LOCACAO
  VENDA_E_LOCACAO
}

enum OpportunityProfile {
  MORADIA
  INVESTIMENTO
  RENDA
  VALORIZACAO
  LANCAMENTO
}

enum PropertyType {
  CASA
  APARTAMENTO
  TERRENO
  COMERCIAL
  RURAL
}

enum PropertyStatus {
  DISPONIVEL
  RESERVADO
  VENDIDO
  ALUGADO
  EM_ANALISE
}

enum PortalLeadStatus {
  NOVO
  CONTATADO
  QUALIFICADO
  VISITA_AGENDADA
  PROPOSTA
  EM_NEGOCIACAO
  CONVERTIDO
  ENCERRADO
}

enum VisitInterest {
  ALTO
  MEDIO
  BAIXO
}

enum VisitReturnType {
  PROPOSTA
  NOVA_VISITA
  SEM_INTERESSE
}

enum PropertyVisitStatus {
  AGENDADA
  REALIZADA
  CANCELADA
}

model Property {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(30)

  title String  @db.VarChar(200)
  slug  String? @unique @db.VarChar(220)

  purpose             PropertyPurpose
  opportunityProfiles OpportunityProfile[] @default([])

  propertyType PropertyType
  category     String       @db.VarChar(100)

  status        PropertyStatus @default(EM_ANALISE)
  highlight     Boolean        @default(false)
  published     Boolean        @default(false)
  internalNotes String?        @db.Text

  tag String? @db.VarChar(100)

  state        String @default("SP") @db.VarChar(2)
  city         String @default("São José dos Campos") @db.VarChar(120)
  neighborhood String @db.VarChar(150)

  development String? @db.VarChar(180)
  location    String? @db.VarChar(250)

  address String? @db.VarChar(250)
  zipCode String? @db.VarChar(12)

  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  googleMapsUrl String?  @db.Text

  mapEnabled      Boolean @default(true)
  mapRadiusMeters Int     @default(700)

  price       Decimal? @db.Decimal(15, 2)
  rentalPrice Decimal? @db.Decimal(15, 2)

  condominium Decimal? @db.Decimal(12, 2)
  iptu        Decimal? @db.Decimal(12, 2)

  area     Decimal? @db.Decimal(10, 2)
  landArea Decimal? @db.Decimal(10, 2)

  bedrooms  Int @default(0)
  suites    Int @default(0)
  bathrooms Int @default(0)
  parking   Int @default(0)

  description String? @db.Text

  features String[] @default([])

  video       String? @db.Text
  virtualTour String? @db.Text
  brochure    String? @db.Text

  seoTitle       String? @db.VarChar(200)
  seoDescription String? @db.VarChar(300)
  seoImage       String? @db.Text

  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId Int?
  owner   Owner? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  captorId Int?
  captor   Agent? @relation("PropertyPrimaryCaptor", fields: [captorId], references: [id], onDelete: SetNull)

  coCaptorId Int?
  coCaptor   Agent? @relation("PropertyCoCaptor", fields: [coCaptorId], references: [id], onDelete: SetNull)

  images                    PropertyImage[]
  portalLeads               PortalLead[]
  whatsAppLeadIntents       WhatsAppLeadIntent[]
  visits                    PropertyVisit[]
  proposals                 PropertyProposal[]
  rentalProposals           PropertyRentalProposal[]
  commercialEventProperties CommercialEventProperty[]

  @@index([ownerId])
  @@index([captorId])
  @@index([coCaptorId])
  @@index([purpose])
  @@index([propertyType])
  @@index([status])
  @@index([city])
  @@index([neighborhood])
  @@index([highlight])
  @@index([published])
}

enum ClientStatus {
  ATIVO
  INATIVO
  CONVERTIDO
}

enum PropertyProposalStatus {
  EM_ANALISE
  CONTRAPROPOSTA
  ACEITA
  RECUSADA
  CANCELADA
}

enum RentalGuaranteeType {
  CAUCAO
  FIADOR
  SEGURO_FIANCA
  TITULO_CAPITALIZACAO
  OUTRA
}

enum CommercialEventType {
  NOVO_CONTATO
  CONTATO_REALIZADO
  CLIENTE_QUALIFICADO
  IMOVEIS_APRESENTADOS
  VISITA_AGENDADA
  VISITA_REALIZADA
  POS_VISITA
  PROPOSTA_APRESENTADA
  CONTRAPROPOSTA
  NEGOCIACAO
  PROPOSTA_ACEITA
  DOCUMENTACAO
  NEGOCIO_CONCLUIDO
  PERDIDO_ENCERRADO
}

model Client {
  id Int @id @default(autoincrement())

  name  String @db.VarChar(180)
  phone String @db.VarChar(30)

  email     String?   @db.VarChar(180)
  document  String?   @db.VarChar(40)
  birthDate DateTime?

  address String? @db.VarChar(300)

  notes String? @db.Text

  status ClientStatus @default(ATIVO)

  agentId Int?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portalLeads      PortalLead[]
  visits           PropertyVisit[]
  proposals        PropertyProposal[]
  rentalProposals  PropertyRentalProposal[]
  commercialEvents CommercialEvent[]

  @@index([agentId])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([status])
}

model PortalLead {
  id Int @id @default(autoincrement())

  propertyId    Int?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  clientId      Int?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  propertyCode  String    @db.VarChar(30)
  propertyTitle String    @db.VarChar(200)

  name  String @db.VarChar(120)
  phone String @db.VarChar(20)

  status PortalLeadStatus @default(NOVO)
  notes  String?          @db.Text

  sourcePage String  @db.VarChar(1000)
  referrer   String? @db.VarChar(1000)

  utmSource   String? @db.VarChar(180)
  utmMedium   String? @db.VarChar(180)
  utmCampaign String? @db.VarChar(250)
  utmTerm     String? @db.VarChar(250)
  utmContent  String? @db.VarChar(250)
  gclid       String? @db.VarChar(255)

  consentVersion String    @db.VarChar(50)
  consentText    String    @db.Text
  consentedAt    DateTime  @default(now())
  contactedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commercialEvents CommercialEvent[]

  @@index([propertyId])
  @@index([propertyCode])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([clientId])
}

model WhatsAppLeadIntent {
  id Int @id @default(autoincrement())

  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  propertyCode String? @db.VarChar(30)

  sourcePage String  @db.VarChar(1000)
  referrer   String? @db.VarChar(1000)

  utmSource   String? @db.VarChar(180)
  utmMedium   String? @db.VarChar(180)
  utmCampaign String? @db.VarChar(250)
  utmTerm     String? @db.VarChar(250)
  utmContent  String? @db.VarChar(250)

  gclid String? @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@index([propertyCode])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([gclid])
  @@index([createdAt])
}

model PropertyVisit {
  id Int @id @default(autoincrement())

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  agentId Int?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  status PropertyVisitStatus @default(REALIZADA)

  visitorName      String    @db.VarChar(180)
  visitorDocument  String?   @db.VarChar(40)
  visitorPhone     String?   @db.VarChar(30)
  visitorEmail     String?   @db.VarChar(180)
  visitorBirthDate DateTime?
  visitorAddress   String?   @db.VarChar(300)

  visitDate DateTime
  visitTime String?  @db.VarChar(10)

  companions String? @db.Text

  interest   VisitInterest?
  returnType VisitReturnType?

  notes String? @db.Text

  visitorSignature     String? @db.Text
  responsibleSignature String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([clientId])
  @@index([agentId])
  @@index([status])
  @@index([visitDate])
  @@index([visitorName])
  @@index([visitorPhone])
}

model PropertyProposal {
  id Int @id @default(autoincrement())

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  agentId Int?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  proposerName     String  @db.VarChar(180)
  proposerDocument String? @db.VarChar(40)
  proposerPhone    String? @db.VarChar(30)
  proposerEmail    String? @db.VarChar(180)

  offeredValue     Decimal? @db.Decimal(15, 2)
  downPaymentValue Decimal? @db.Decimal(15, 2)

  usesOwnResources Boolean @default(false)
  usesFinancing    Boolean @default(false)
  usesFgts         Boolean @default(false)

  paymentTerms      String?   @db.Text
  deadline          String?   @db.VarChar(180)
  specialConditions String?   @db.Text
  validUntil        DateTime?
  notes             String?   @db.Text

  counterOfferValue Decimal? @db.Decimal(15, 2)
  counterOfferTerms String?  @db.Text
  counterOfferNotes String?  @db.Text

  status PropertyProposalStatus @default(EM_ANALISE)

  proposerSignature String? @db.Text
  ownerSignature    String? @db.Text
  agentSignature    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([clientId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
  @@index([proposerName])
}

model PropertyRentalProposal {
  id Int @id @default(autoincrement())

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  agentId Int?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  tenantName     String  @db.VarChar(180)
  tenantDocument String? @db.VarChar(40)
  tenantPhone    String? @db.VarChar(30)
  tenantEmail    String? @db.VarChar(180)

  offeredRentValue     Decimal  @db.Decimal(15, 2)
  condominiumValue     Decimal? @db.Decimal(12, 2)
  iptuValue            Decimal? @db.Decimal(12, 2)
  securityDepositValue Decimal? @db.Decimal(15, 2)

  desiredStartDate DateTime?
  leaseTermMonths  Int?

  guaranteeType     RentalGuaranteeType?
  guaranteeDetails  String?              @db.Text
  specialConditions String?              @db.Text
  validUntil        DateTime?
  notes             String?              @db.Text

  counterOfferRent  Decimal? @db.Decimal(15, 2)
  counterOfferTerms String?  @db.Text
  counterOfferNotes String?  @db.Text

  status PropertyProposalStatus @default(EM_ANALISE)

  tenantSignature String? @db.Text
  ownerSignature  String? @db.Text
  agentSignature  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([clientId])
  @@index([agentId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantName])
}

model CommercialEvent {
  id Int @id @default(autoincrement())

  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  agentId Int?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  leadId Int?
  lead   PortalLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  type CommercialEventType

  description String?  @db.Text
  amount      Decimal? @db.Decimal(15, 2)

  eventAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties CommercialEventProperty[]

  @@index([clientId])
  @@index([agentId])
  @@index([leadId])
  @@index([type])
  @@index([eventAt])
}

model CommercialEventProperty {
  id Int @id @default(autoincrement())

  commercialEventId Int
  commercialEvent   CommercialEvent @relation(fields: [commercialEventId], references: [id], onDelete: Cascade)

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commercialEventId, propertyId])
  @@index([commercialEventId])
  @@index([propertyId])
}

model PropertyImage {
  id Int @id @default(autoincrement())

  propertyId Int

  url String  @db.Text
  alt String? @db.VarChar(250)

  position      Int     @default(0)
  isCover       Boolean @default(false)
  isAiGenerated Boolean @default(false)

  createdAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, position])
}

model Owner {
  id Int @id @default(autoincrement())

  name  String  @db.VarChar(180)
  phone String? @db.VarChar(30)
  email String? @db.VarChar(180)

  rg  String? @db.VarChar(30)
  cpf String? @unique @db.VarChar(20)

  address      String? @db.VarChar(250)
  complement   String? @db.VarChar(120)
  neighborhood String? @db.VarChar(150)
  city         String? @db.VarChar(120)
  state        String? @db.VarChar(2)
  zipCode      String? @db.VarChar(12)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capturedById Int?
  capturedBy   Agent? @relation(fields: [capturedById], references: [id], onDelete: SetNull)

  properties Property[]

  @@index([capturedById])
  @@index([name])
  @@index([phone])
  @@index([email])
}

enum AgentRole {
  ADMIN
  CAPTADOR
}

model Agent {
  id Int @id @default(autoincrement())

  name  String  @db.VarChar(180)
  email String  @unique @db.VarChar(180)
  phone String? @db.VarChar(30)
  creci String? @db.VarChar(50)

  role AgentRole @default(CAPTADOR)

  passwordHash String @db.VarChar(200)
  passwordSalt String @db.VarChar(200)

  active Boolean @default(true)

  capturedOwners Owner[]

  capturedProperties   Property[] @relation("PropertyPrimaryCaptor")
  coCapturedProperties Property[] @relation("PropertyCoCaptor")

  clients           Client[]
  visits            PropertyVisit[]
  proposals          PropertyProposal[]
  rentalProposals  PropertyRentalProposal[]
  commercialEvents CommercialEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([role])
  @@index([active])
}

enum AcquisitionSource {
  OLX
  ZAP
  VIVAREAL
  IMOVELWEB
  SITE_IMOBILIARIA
  OUTRO
}

enum AcquisitionOrigin {
  PROPRIETARIO
  IMOBILIARIA
  CORRETOR
  OUTRO
}

enum AcquisitionStatus {
  ENCONTRADO
  SELECIONADO
  CONTATADO
  AGUARDANDO_AUTORIZACAO
  AUTORIZADO
  PUBLICADO
  DESCARTADO
  ARQUIVADO
}

enum AuthorizationStatus {
  NAO_SOLICITADA
  PENDENTE
  AUTORIZADA
  NEGADA
  REVOGADA
}

model AcquisitionOpportunity {
  id Int @id @default(autoincrement())

  source    AcquisitionSource
  sourceUrl String            @unique @db.VarChar(1000)

  origin AcquisitionOrigin?

  status              AcquisitionStatus   @default(ENCONTRADO)
  authorizationStatus AuthorizationStatus @default(NAO_SOLICITADA)

  sourceTitle String? @db.VarChar(250)

  state        String  @default("SP") @db.VarChar(2)
  city         String  @default("São José dos Campos") @db.VarChar(120)
  neighborhood String? @db.VarChar(150)

  development String? @db.VarChar(180)
  location    String? @db.VarChar(250)

  purpose      PropertyPurpose?
  propertyType PropertyType?

  price       Decimal? @db.Decimal(15, 2)
  rentalPrice Decimal? @db.Decimal(15, 2)

  condominium Decimal? @db.Decimal(12, 2)
  iptu        Decimal? @db.Decimal(12, 2)

  area     Decimal? @db.Decimal(10, 2)
  landArea Decimal? @db.Decimal(10, 2)

  bedrooms  Int?
  suites    Int?
  bathrooms Int?
  parking   Int?

  contactName  String? @db.VarChar(180)
  contactPhone String? @db.VarChar(30)
  contactEmail String? @db.VarChar(180)

  score       Int?
  scoreReason String? @db.Text

  internalNotes String? @db.Text

  contactedAt              DateTime?
  authorizationRequestedAt DateTime?
  authorizationAt          DateTime?

  authorizationNotes String? @db.Text

  authorizedToAdvertise  Boolean @default(false)
  authorizedToUseImages  Boolean @default(false)
  authorizedToEditImages Boolean @default(false)

  firstSeenAt   DateTime  @default(now())
  lastCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([origin])
  @@index([status])
  @@index([authorizationStatus])
  @@index([city])
  @@index([neighborhood])
  @@index([price])
  @@index([score])
  @@index([createdAt])
}

model MarketReference {
  id Int @id @default(autoincrement())

  state        String  @default("SP") @db.VarChar(2)
  city         String  @db.VarChar(120)
  neighborhood String  @db.VarChar(150)
  development  String? @db.VarChar(180)

  purpose      PropertyPurpose
  propertyType PropertyType

  areaMin  Decimal? @db.Decimal(10, 2)
  areaMax  Decimal? @db.Decimal(10, 2)
  bedrooms Int?

  pricePerSquareMeterMin Decimal @db.Decimal(12, 2)
  pricePerSquareMeterMax Decimal @db.Decimal(12, 2)

  sampleSize Int     @default(0)
  active     Boolean @default(true)

  calculatedAt DateTime  @default(now())
  validUntil   DateTime?
  notes        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidences MarketEvidence[]

  @@index([city, neighborhood])
  @@index([city, neighborhood, development])
  @@index([purpose, propertyType])
  @@index([active, calculatedAt])
}

model MarketEvidence {
  id Int @id @default(autoincrement())

  marketReferenceId Int
  marketReference   MarketReference @relation(fields: [marketReferenceId], references: [id], onDelete: Cascade)

  source       String   @db.VarChar(120)
  sourceUrl    String   @db.VarChar(1000)
  researchedAt DateTime @default(now())

  propertyType PropertyType
  purpose      PropertyPurpose
  area         Decimal?        @db.Decimal(10, 2)
  bedrooms     Int?
  price        Decimal?        @db.Decimal(15, 2)

  pricePerSquareMeter Decimal? @db.Decimal(12, 2)

  development String? @db.VarChar(180)
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketReferenceId])
  @@index([source])
  @@index([researchedAt])
}

model NeighborhoodMapLocation {
  id Int @id @default(autoincrement())

  state          String   @default("SP") @db.VarChar(2)
  city           String   @db.VarChar(120)
  normalizedName String   @db.VarChar(180)
  displayName    String   @db.VarChar(180)
  aliases        String[] @default([])

  latitude     Decimal @db.Decimal(10, 7)
  longitude    Decimal @db.Decimal(10, 7)
  radiusMeters Int     @default(700)
  active       Boolean @default(true)

  source     String?   @db.VarChar(180)
  sourceUrl  String?   @db.VarChar(1000)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([state, city, normalizedName])
  @@index([state, city])
  @@index([active])
}
